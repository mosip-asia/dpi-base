# ==============================================================================
# 🐮 DPI Center — Rancher Host Configuration (Single Source of Truth)
# ==============================================================================
# Tracked in git. remote-deploy.sh copies it to /opt/rancher/.env.template and
# deploy.sh sources it. No secrets in this file. Operator-only overrides may go in
# /opt/rancher/.env on the VM (mode 0600, never committed).
#
# Upgrading a component = change its pin here, commit, run ./base-kube-ops/remote-deploy.sh
# (a Rancher version change also needs --confirm-rancher-upgrade; see README "Upgrades").
# ==============================================================================

# --- Paths & Projects ---
RANCHER_DIR="/opt/rancher"
MGMT_PROJECT="base-mgmt"

# --- Names ---
# Rancher server URL host: a CNAME in parent zone dpi-center -> RANCHER_BASE_FQDN, created by hand.
# Downstream clusters store this name; changing it later means re-importing every cluster.
RANCHER_FQDN="rancher.dpi.ait.ac.th"
# A record owned by base-kube-ops/terraform/dns.tf
RANCHER_BASE_FQDN="rancher.base.dpi.ait.ac.th"

# --- Let's Encrypt (HTTP-01 through K3s Traefik; port 80 stays open) ---
ACME_EMAIL="admin@dpi.ait.ac.th"
LETSENCRYPT_ENVIRONMENT="production"

# --- Version Pins (AGENTS.md security rule 5) ---
K3S_VERSION="v1.36.3+k3s1"
HELM_VERSION="v3.19.0"
CERT_MANAGER_VERSION="v1.21.1"
# rancher-stable is Rancher's recommended repository for production
RANCHER_CHART_REPO="rancher-stable"
RANCHER_CHART_REPO_URL="https://releases.rancher.com/server-charts/stable"
RANCHER_CHART_VERSION="2.15.1"

# --- Rancher Settings ---
RANCHER_REPLICAS="1"
# How downstream agents trust the server certificate: system-store trusts public CAs
# from the OS store (Let's Encrypt); strict trusts only Rancher's cacerts setting.
# Once set through Helm, only Helm can change it.
AGENT_TLS_MODE="system-store"
