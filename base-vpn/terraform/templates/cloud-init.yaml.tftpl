#cloud-config

package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - sqlite3
  - curl
  - jq

timezone: Asia/Bangkok

write_files:
  - path: /opt/dpi/traefik/acme.json
    permissions: '0600'
    content: ''

  - path: /opt/dpi/.env
    permissions: '0600'
    content: |
      GOOGLE_OAUTH_CLIENT_ID="${google_oauth_client_id}"
      GOOGLE_OAUTH_CLIENT_SECRET="${google_oauth_client_secret}"
      NETBIRD_RELAY_SECRET="${netbird_relay_secret}"

  - path: /opt/dpi/docker-compose.yml
    permissions: '0644'
    content: |
${indent(6, docker_compose_content)}

  - path: /opt/dpi/netbird/management.json
    permissions: '0644'
    content: |
${indent(6, management_json_content)}

  - path: /opt/dpi/scripts/backup_to_gcs.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      if [ -f /opt/dpi/netbird/data/store.db ]; then
          sqlite3 /opt/dpi/netbird/data/store.db ".backup /tmp/netbird_store.db"
          gcloud storage cp /tmp/netbird_store.db "gs://${state_bucket}/backups/netbird/store.db" --quiet
          rm -f /tmp/netbird_store.db
      fi

  - path: /etc/systemd/system/dpi-vpn.service
    permissions: '0644'
    content: |
      [Unit]
      Description=DPI Center NetBird VPN Fabric (Docker Compose)
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/dpi
      ExecStart=/usr/bin/docker compose up -d --remove-orphans
      ExecStop=/usr/bin/docker compose down
      ExecStopPost=/opt/dpi/scripts/backup_to_gcs.sh
      TimeoutStartSec=300

      [Install]
      WantedBy=multi-user.target

runcmd:
  # 1. Enable and start Docker
  - systemctl enable docker
  - systemctl start docker

  # 2. Local loopback to bypass GCP hairpin NAT for Traefik
  - echo "127.0.0.1 ${netbird_fqdn}" >> /etc/hosts

  # 3. Create required directories with proper permissions
  - mkdir -p /opt/dpi/netbird/data /opt/dpi/traefik /opt/dpi/scripts
  - chmod 600 /opt/dpi/traefik/acme.json

  # 4. Restore NetBird SQLite Database from GCS if exists
  - |
    if gcloud storage cp "gs://${state_bucket}/backups/netbird/store.db" /opt/dpi/netbird/data/store.db 2>/dev/null; then
        echo "Restored NetBird store.db from GCS"
        chmod 600 /opt/dpi/netbird/data/store.db
    else
        echo "No previous NetBird database found in GCS. Starting clean."
    fi

  # 5. Enable and start dpi-vpn service
  - systemctl daemon-reload
  - systemctl enable dpi-vpn.service
  - systemctl start dpi-vpn.service

  # 6. Install 6-hourly backup cron
  - (crontab -l 2>/dev/null | grep -v 'backup_to_gcs.sh' || true; echo "0 */6 * * * /opt/dpi/scripts/backup_to_gcs.sh >/dev/null 2>&1") | crontab -
