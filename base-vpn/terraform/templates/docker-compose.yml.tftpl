services:
  # ==========================================================
  # 🔒 Traefik v3: Edge Proxy & Automated Let's Encrypt SSL
  # ==========================================================
  traefik:
    image: traefik:${traefik_version}
    container_name: traefik
    restart: unless-stopped
    environment:
      - DOCKER_API_VERSION=1.44
      - TZ=Asia/Bangkok
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network=dpi-vpn-net"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      # Auto HTTP to HTTPS redirect
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      # Automated Let's Encrypt SSL
      - "--certificatesresolvers.letsencrypt.acme.email=${acme_email}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/etc/traefik/acme.json"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - "/opt/dpi/traefik/acme.json:/etc/traefik/acme.json"
      - "/etc/localtime:/etc/localtime:ro"
      - "/etc/timezone:/etc/timezone:ro"
    networks:
      - vpn-network

  # ==========================================================
  # 📡 NetBird: Web Dashboard UI
  # ==========================================================
  netbird-dashboard:
    image: netbirdio/dashboard:latest
    container_name: netbird-dashboard
    restart: unless-stopped
    environment:
      - TZ=Asia/Bangkok
      - NETBIRD_MGMT_API_ENDPOINT=https://${netbird_fqdn}
      - NETBIRD_MGMT_GRPC_API_ENDPOINT=https://${netbird_fqdn}
      - AUTH_AUTHORITY=https://accounts.google.com
      - AUTH_CLIENT_ID=$${GOOGLE_OAUTH_CLIENT_ID}
      - AUTH_CLIENT_SECRET=$${GOOGLE_OAUTH_CLIENT_SECRET}
      - AUTH_AUDIENCE=$${GOOGLE_OAUTH_CLIENT_ID}
      - AUTH_SUPPORTED_SCOPES=openid profile email
      - AUTH_REDIRECT_URI=/auth
      - AUTH_SILENT_REDIRECT_URI=/silent-auth
      - NETBIRD_TOKEN_SOURCE=idToken
      - NETBIRD_CSP=https://oauth2.googleapis.com https://www.googleapis.com https://accounts.google.com
      - USE_AUTH0=false
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netbird-dashboard.rule=Host(`${netbird_fqdn}`)"
      - "traefik.http.routers.netbird-dashboard.entrypoints=websecure"
      - "traefik.http.routers.netbird-dashboard.tls.certresolver=letsencrypt"
      - "traefik.http.routers.netbird-dashboard.priority=1"
      - "traefik.http.services.netbird-dashboard.loadbalancer.server.port=80"
    networks:
      - vpn-network

  # ==========================================================
  # 📡 NetBird: Self-Hosted WireGuard VPN Signal Service
  # ==========================================================
  netbird-signal:
    image: netbirdio/signal:${netbird_version}
    container_name: netbird-signal
    restart: unless-stopped
    environment:
      - TZ=Asia/Bangkok
    volumes:
      - "/etc/localtime:/etc/localtime:ro"
      - "/etc/timezone:/etc/timezone:ro"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netbird-signal.rule=Host(`${netbird_fqdn}`) && PathPrefix(`/signalexchange.SignalExchange/`)"
      - "traefik.http.routers.netbird-signal.entrypoints=websecure"
      - "traefik.http.routers.netbird-signal.tls.certresolver=letsencrypt"
      - "traefik.http.routers.netbird-signal.priority=100"
      - "traefik.http.routers.netbird-signal.service=netbird-signal"
      - "traefik.http.services.netbird-signal.loadbalancer.server.port=80"
      - "traefik.http.services.netbird-signal.loadbalancer.server.scheme=h2c"
    networks:
      - vpn-network

  # ==========================================================
  # 📡 NetBird: Self-Hosted WireGuard Management Control Plane
  # ==========================================================
  netbird-management:
    image: netbirdio/management:${netbird_version}
    container_name: netbird-management
    restart: unless-stopped
    environment:
      - TZ=Asia/Bangkok
      - NB_SETUP_PAT_ENABLED=true
    command: ["--config", "/etc/netbird/management.json", "--log-file", "console"]
    volumes:
      - "/opt/dpi/netbird/management.json:/etc/netbird/management.json"
      - "/opt/dpi/netbird/data:/var/lib/netbird"
      - "/etc/localtime:/etc/localtime:ro"
      - "/etc/timezone:/etc/timezone:ro"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netbird-mgmt.rule=Host(`${netbird_fqdn}`) && (PathPrefix(`/api`) || PathPrefix(`/management.`) || PathPrefix(`/.well-known`) || PathPrefix(`/oauth2`) || PathPrefix(`/dex`))"
      - "traefik.http.routers.netbird-mgmt.entrypoints=websecure"
      - "traefik.http.routers.netbird-mgmt.tls.certresolver=letsencrypt"
      - "traefik.http.routers.netbird-mgmt.priority=10"
      - "traefik.http.services.netbird-mgmt.loadbalancer.server.port=80"
      - "traefik.http.services.netbird-mgmt.loadbalancer.server.scheme=h2c"
    networks:
      - vpn-network

  # ==========================================================
  # 📡 NetBird: Self-Hosted WireGuard Relay Service (WebSocket / TCP 443)
  # ==========================================================
  netbird-relay:
    image: netbirdio/relay:${netbird_version}
    container_name: netbird-relay
    restart: unless-stopped
    command:
      - "relay"
      - "--listen-address=:33080"
      - "--exposed-address=rels://${netbird_fqdn}:443/relay"
      - "--auth-secret=$${NETBIRD_RELAY_SECRET}"
      - "--log-level=info"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netbird-relay.rule=Host(`${netbird_fqdn}`) && PathPrefix(`/relay`)"
      - "traefik.http.routers.netbird-relay.entrypoints=websecure"
      - "traefik.http.routers.netbird-relay.tls.certresolver=letsencrypt"
      - "traefik.http.services.netbird-relay.loadbalancer.server.port=33080"
    networks:
      - vpn-network

networks:
  vpn-network:
    name: dpi-vpn-net
