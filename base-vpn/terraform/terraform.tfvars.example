# ==========================================================
# ⚙️ DPI Base VPN — Component Version Configuration
# ==========================================================
# Copy this file to terraform.tfvars to select specific versions:
#   cp terraform.tfvars.example terraform.tfvars
#
# When Dependabot opens PRs for major updates, adjust these values
# and re-apply to update the NetBird service stack.
# ==========================================================

# Traefik Edge Proxy version (Docker Hub: traefik)
traefik_version = "v3.7"

# NetBird Control Plane version (Docker Hub: netbirdio/management, signal, relay)
netbird_version = "0.78.1"

# NetBird Dashboard UI version (Docker Hub: netbirdio/dashboard)
netbird_dashboard_version = "v2.92.0"
