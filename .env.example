# ==============================================================================
# DPI Center — Domain Landing Zone Seed Bootstrap Configuration
# ==============================================================================
# Instructions:
#   1. Copy this file to .env at the repository root:
#        cp .env.example .env
#   2. Fill in the required variables below (DOMAIN_NAME, BILLING_ACCOUNT_ID).
#   3. Validate your configuration:
#        ./scripts/check_env.sh
#   4. Preview what will be created:
#        ./scripts/bootstrap_domain.sh --plan
#   5. Run the bootstrap script:
#        ./scripts/bootstrap_domain.sh
# ==============================================================================

# --- [REQUIRED] Domain & Billing Identity ---

# DOMAIN_NAME defines the sovereign identity for this initiative:
#   1. GCP Folder Name      : Appears in GCP Resource Manager (e.g. 'mosip-asia')
#   2. Project Name Prefix  : Prefixes ALL projects under this folder:
#                             - <DOMAIN_NAME>-mgmt   (Management anchor: state, secrets, DNS)
#                             - <DOMAIN_NAME>-*      (Future workloads: k3s, db, sandboxes)
#   3. Cloud DNS Namespace  : <DOMAIN_NAME>.dpi.ait.ac.th
#   4. Git Management Dir   : <DOMAIN_NAME>-mgmt/ (Directory containing Terraform code)
#
# Constraints:
#   - Lowercase letters, numbers, and hyphens only (^[a-z0-9-]+$)
#   - Maximum 24 characters (ensures '<DOMAIN_NAME>-mgmt' fits GCP's 30-char project ID limit)
# Examples: "mosip-asia", "ai-team", "dlms", "sandbox-a"
DOMAIN_NAME="example-domain"

# Google Cloud Billing Account ID (from GCP Console -> Billing)
# Format: "XXXXXX-XXXXXX-XXXXXX"
BILLING_ACCOUNT_ID="01XXXX-XXXXXX-XXXXXX"


# --- [OPTIONAL] Hierarchy & Region Settings ---

# GCP Organization ID (Default: 350922776586 for dpi.ait.ac.th)
ORGANIZATION_ID="350922776586"

# Parent apex domain for the organization
PARENT_DOMAIN="dpi.ait.ac.th"

# Target GCP region for remote state bucket and resources
REGION="asia-southeast1"


# --- [OPTIONAL] Team Access & Collaborators ---

# Comma-separated list of Folder Administrators (granted Folder Admin / Editor)
FOLDER_ADMINS="akraradet@ait.asia,nuttasit@ait.asia"

# Comma-separated list of Folder Members (granted Folder Viewer)
FOLDER_MEMBERS=""
