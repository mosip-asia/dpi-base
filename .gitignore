# ==========================================
# 🛑 DPI Center - Security & DevOps .gitignore
# ==========================================

# --- Terraform State & Secrets ---
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
.terraform/
.terraform.lock.hcl

# --- Environment & Secret Files ---
.env
*.env
*.env.local
*.secret
*.secret.*
credentials.json
client_secret*.json
service-account*.json

# --- SSH & SSL Certificates ---
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
letsencrypt/
acme.json

# --- Runtime Data & Databases ---
data/
**/data/
*.sqlite
*.sqlite3
*.db

# --- Logs, Cache & Python Environments ---
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- IDE & Editors ---
.DS_Store
.idea/
.vscode/
/.obsidian/workspace.json

# --- Preserved Placeholders ---
!.keep
